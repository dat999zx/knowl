{
  "name": "@dat999zx/knowl",
  "version": "2.11.0",
  "description": "A Knowledge Operating System for AI Agents",
  "main": "dist/index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dat999zx/knowl.git"
  },
  "homepage": "https://github.com/dat999zx/knowl#readme",
  "bugs": {
    "url": "https://github.com/dat999zx/knowl/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "knowl": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --dts",
    "benchmark:build": "tsup benchmarks/accuracy/src/cli.ts --format esm --out-dir benchmarks/accuracy/dist --clean",
    "benchmark:generate": "npm run benchmark:build && node benchmarks/accuracy/dist/cli.js generate",
    "benchmark:accuracy": "npm run benchmark:build && node benchmarks/accuracy/dist/cli.js all",
    "dev": "tsup src/index.ts --format esm --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:bench": "vitest run --config benchmarks/vitest.config.ts",
    "typecheck:bench": "tsc -p benchmarks/tsconfig.json",
    "bench:cr:build": "tsup benchmarks/memoryagentbench/cli.ts --format esm --outDir .benchmark-dist",
    "bench:cr": "npm run bench:cr:build --silent && node .benchmark-dist/cli.js"
  },
  "keywords": [
    "mcp",
    "knowledge",
    "agent",
    "memory",
    "sqlite"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.12",
    "@ai-sdk/openai": "^4.0.11",
    "@huggingface/transformers": "^4.2.0",
    "@inquirer/prompts": "^8.5.2",
    "@libsql/client": "^0.14.0",
    "@modelcontextprotocol/sdk": "^1.4.1",
    "ai": "^7.0.22",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "smol-toml": "^1.7.0",
    "stream-json": "^3.5.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
