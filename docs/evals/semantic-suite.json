{
  "version": 1,
  "description": "Semantic retrieval suite. Tiered basic/moderate/extreme, weighted toward ordinary paraphrase because real stored atoms are ordinary. Extreme cases have zero content-word overlap with their target and carry a lexical decoy. Built to discriminate between embedding models, which the lexical retrieval-suite.json cannot.",
  "fixtures": [
    {
      "id": "soft-delete",
      "category": "architecture",
      "title": "Rows are flagged, never dropped",
      "content": "Records carry a deleted_at timestamp. Nothing leaves the table, so an accidental delete is undone by clearing the flag.",
      "tags": [
        "persistence",
        "deletion"
      ]
    },
    {
      "id": "hard-purge",
      "category": "decision",
      "title": "Nightly purge drops expired audit rows",
      "content": "Audit rows older than 400 days are removed by the nightly job. That erasure is permanent and intentionally so.",
      "tags": [
        "audit",
        "retention"
      ]
    },
    {
      "id": "db-postgres",
      "category": "decision",
      "title": "PostgreSQL as the primary datastore",
      "content": "PostgreSQL 16 is the primary transactional datastore. It is the system of record and the one store that must never lose a write.",
      "tags": [
        "database",
        "persistence"
      ]
    },
    {
      "id": "cache-redis",
      "category": "decision",
      "title": "Redis caches read-heavy endpoints",
      "content": "Redis holds a five minute cache for product listing responses. Losing it costs latency and nothing else.",
      "tags": [
        "cache",
        "performance"
      ]
    },
    {
      "id": "auth-jwt",
      "category": "architecture",
      "title": "Access tokens are short-lived JWTs",
      "content": "Clients receive a JWT valid for fifteen minutes, signed with RS256. The public key is served from a JWKS endpoint.",
      "tags": [
        "auth",
        "tokens"
      ]
    },
    {
      "id": "auth-refresh",
      "category": "architecture",
      "title": "Refresh tokens rotate on every use",
      "content": "Each refresh returns a new refresh token and invalidates the old one. A replayed token revokes the whole family.",
      "tags": [
        "auth",
        "tokens"
      ]
    },
    {
      "id": "rate-limit-api",
      "category": "constraint",
      "title": "Public API allows 100 requests a minute",
      "content": "Every API key gets 100 requests per minute in a sliding window. Going over returns 429 with a Retry-After header.",
      "tags": [
        "api",
        "limits"
      ]
    },
    {
      "id": "rate-limit-login",
      "category": "constraint",
      "title": "Sign-in locks after five failed attempts",
      "content": "Five failed sign-in attempts from one address lock that account for fifteen minutes. The counter resets on success.",
      "tags": [
        "auth",
        "limits"
      ]
    },
    {
      "id": "deploy-blue-green",
      "category": "decision",
      "title": "Blue-green deploys with instant switchover",
      "content": "Two identical production stacks run side by side. Traffic swaps at the load balancer, and going back is another swap.",
      "tags": [
        "deploy",
        "release"
      ]
    },
    {
      "id": "deploy-canary",
      "category": "decision",
      "title": "Canary release to five percent first",
      "content": "New builds take five percent of traffic for thirty minutes. Error rate above baseline halts the rollout automatically.",
      "tags": [
        "deploy",
        "release"
      ]
    },
    {
      "id": "feature-flags",
      "category": "architecture",
      "title": "Feature flags gate unfinished work",
      "content": "Flags are evaluated per request and default to off. Merged but unfinished code ships dark behind a flag.",
      "tags": [
        "flags",
        "release"
      ]
    },
    {
      "id": "config-env",
      "category": "constraint",
      "title": "Configuration comes from environment variables",
      "content": "All runtime settings are read from environment variables at boot. Nothing reads a config file in production.",
      "tags": [
        "config",
        "deploy"
      ]
    },
    {
      "id": "migrations-forward",
      "category": "constraint",
      "title": "Migrations run forward only",
      "content": "Schema changes are applied forward. A bad migration is answered by writing another migration, never by editing history.",
      "tags": [
        "database",
        "schema"
      ]
    },
    {
      "id": "migrations-expand",
      "category": "architecture",
      "title": "Expand and contract for column changes",
      "content": "A rename adds the new column, backfills it, switches reads over, then drops the old column in a later release.",
      "tags": [
        "database",
        "schema"
      ]
    },
    {
      "id": "logs-structured",
      "category": "decision",
      "title": "Logs are structured JSON lines",
      "content": "Every log line is a JSON object carrying a request id. Free-text logging was removed so queries can filter by field.",
      "tags": [
        "logging",
        "observability"
      ]
    },
    {
      "id": "metrics-prometheus",
      "category": "decision",
      "title": "Prometheus scrapes service metrics",
      "content": "Each service exposes /metrics for Prometheus. Counters and histograms only; gauges are avoided on request paths.",
      "tags": [
        "metrics",
        "observability"
      ]
    },
    {
      "id": "tracing-otel",
      "category": "architecture",
      "title": "OpenTelemetry traces cross service calls",
      "content": "Trace context propagates through headers on every internal call, so one request id links the whole path.",
      "tags": [
        "tracing",
        "observability"
      ]
    },
    {
      "id": "alerting-pager",
      "category": "decision",
      "title": "Only customer-facing failures page a human",
      "content": "Alerts that wake someone are limited to user-visible breakage. Everything else opens a ticket in the morning queue.",
      "tags": [
        "alerting",
        "oncall"
      ]
    },
    {
      "id": "retention-audit",
      "category": "constraint",
      "title": "Audit events kept for seven years",
      "content": "Compliance requires audit events be retained seven years. The retention clock starts at write time and cold storage takes them after ninety days.",
      "tags": [
        "audit",
        "compliance"
      ]
    },
    {
      "id": "retention-backup",
      "category": "constraint",
      "title": "Backups kept thirty days, restored weekly",
      "content": "Nightly backups are retained thirty days. A restore is rehearsed weekly so recovery is a practised path rather than a first attempt.",
      "tags": [
        "backup",
        "recovery"
      ]
    },
    {
      "id": "queue-retry",
      "category": "architecture",
      "title": "Jobs retry with exponential backoff",
      "content": "A failed job retries six times with exponential backoff and jitter, spreading load instead of hammering the same target.",
      "tags": [
        "queue",
        "jobs"
      ]
    },
    {
      "id": "queue-dlq",
      "category": "architecture",
      "title": "Exhausted jobs land in a dead letter queue",
      "content": "After the final attempt the job moves to a dead letter queue for inspection. Nothing is discarded silently.",
      "tags": [
        "queue",
        "jobs"
      ]
    },
    {
      "id": "tests-unit",
      "category": "decision",
      "title": "Unit tests run on every commit",
      "content": "The unit suite runs on every commit and must finish under two minutes. Anything slower belongs in the nightly suite.",
      "tags": [
        "testing",
        "ci"
      ]
    },
    {
      "id": "tests-e2e",
      "category": "decision",
      "title": "End-to-end tests run before release",
      "content": "The browser suite runs against a staging environment before each release, not on every commit.",
      "tags": [
        "testing",
        "release"
      ]
    },
    {
      "id": "ci-pipeline",
      "category": "architecture",
      "title": "One pipeline builds, tests and publishes",
      "content": "A single pipeline definition builds the image, runs the suites and publishes artifacts. Branches take the same path as main.",
      "tags": [
        "ci",
        "build"
      ]
    },
    {
      "id": "release-tags",
      "category": "constraint",
      "title": "Releases are signed semver tags",
      "content": "Every release is a signed tag following semantic versioning. Nothing ships from an untagged commit.",
      "tags": [
        "release",
        "versioning"
      ]
    },
    {
      "id": "secrets-vault",
      "category": "decision",
      "title": "Secrets live in the managed vault",
      "content": "Credentials are fetched from the vault at boot. No secret is committed, and none appears in an environment dump.",
      "tags": [
        "secrets",
        "security"
      ]
    },
    {
      "id": "secrets-rotation",
      "category": "constraint",
      "title": "Database credentials rotate every ninety days",
      "content": "The vault issues a short-lived database credential that rotates every ninety days without a redeploy.",
      "tags": [
        "secrets",
        "database"
      ]
    },
    {
      "id": "cdn-assets",
      "category": "architecture",
      "title": "Static assets are served from the CDN",
      "content": "Hashed asset filenames are published to a CDN bucket and cached for a year. The origin never serves a static file.",
      "tags": [
        "cdn",
        "performance"
      ]
    },
    {
      "id": "image-resize",
      "category": "architecture",
      "title": "Images are resized on upload, not on read",
      "content": "Three sizes are generated when an image is first stored. The read path never resizes, so its cost stays predictable.",
      "tags": [
        "images",
        "performance"
      ]
    },
    {
      "id": "search-index",
      "category": "architecture",
      "title": "Search runs on an inverted index",
      "content": "Documents are indexed on write into an inverted index. Queries never scan the primary tables.",
      "tags": [
        "search",
        "indexing"
      ]
    },
    {
      "id": "search-synonyms",
      "category": "decision",
      "title": "Synonym list is curated by hand",
      "content": "A hand-curated synonym list maps product vocabulary to what customers actually type. It is reviewed each quarter.",
      "tags": [
        "search",
        "vocabulary"
      ]
    },
    {
      "id": "email-transactional",
      "category": "architecture",
      "title": "Transactional email sends immediately",
      "content": "Receipts and password resets are queued and delivered within seconds. They skip the batching used elsewhere.",
      "tags": [
        "email",
        "notifications"
      ]
    },
    {
      "id": "email-digest",
      "category": "decision",
      "title": "Activity digests batch into one daily email",
      "content": "Activity notifications collect into a single daily digest, so a busy account never receives a hundred messages.",
      "tags": [
        "email",
        "notifications"
      ]
    },
    {
      "id": "webhooks-signing",
      "category": "constraint",
      "title": "Outgoing webhooks carry an HMAC signature",
      "content": "Each webhook body is signed with a shared secret. Receivers must verify the signature before trusting the payload.",
      "tags": [
        "webhooks",
        "security"
      ]
    },
    {
      "id": "webhooks-retries",
      "category": "architecture",
      "title": "Webhook delivery retries for a day",
      "content": "A failing endpoint is retried with backoff for twenty-four hours, then disabled and reported to its owner.",
      "tags": [
        "webhooks",
        "reliability"
      ]
    },
    {
      "id": "pagination-cursor",
      "category": "decision",
      "title": "List endpoints paginate by cursor",
      "content": "Cursor pagination keeps results steady while rows are inserted. Offset paging was dropped for exactly that reason.",
      "tags": [
        "api",
        "pagination"
      ]
    },
    {
      "id": "pagination-limits",
      "category": "constraint",
      "title": "Page size is capped at 100 entries",
      "content": "A request may ask for at most 100 entries per page. Larger values are clamped rather than rejected.",
      "tags": [
        "api",
        "pagination"
      ]
    },
    {
      "id": "idempotency-keys",
      "category": "architecture",
      "title": "Writes accept an idempotency key",
      "content": "A repeated request carrying the same idempotency key returns the original response instead of acting twice.",
      "tags": [
        "api",
        "reliability"
      ]
    },
    {
      "id": "dedupe-hash",
      "category": "architecture",
      "title": "Duplicate uploads are detected by content hash",
      "content": "An upload whose content hash already exists links to the stored object rather than writing a second copy.",
      "tags": [
        "storage",
        "dedupe"
      ]
    },
    {
      "id": "timezone-utc",
      "category": "constraint",
      "title": "Timestamps are stored in UTC",
      "content": "Every stored timestamp is UTC. Conversion to a local zone happens in the presentation layer only.",
      "tags": [
        "time",
        "data"
      ]
    },
    {
      "id": "locale-format",
      "category": "decision",
      "title": "Dates render in the viewer locale",
      "content": "Dates and numbers are formatted with the viewer locale at render time, never baked into a stored string.",
      "tags": [
        "locale",
        "ui"
      ]
    },
    {
      "id": "uploads-s3",
      "category": "architecture",
      "title": "Uploads go straight to object storage",
      "content": "Clients upload directly to object storage with a presigned URL. The application never proxies file bytes.",
      "tags": [
        "storage",
        "uploads"
      ]
    },
    {
      "id": "uploads-limits",
      "category": "constraint",
      "title": "Uploads are capped at 25 megabytes",
      "content": "A single upload may not exceed 25 megabytes. Larger files are refused before any bytes are stored.",
      "tags": [
        "storage",
        "limits"
      ]
    },
    {
      "id": "session-timeout",
      "category": "constraint",
      "title": "Idle sessions end after thirty minutes",
      "content": "A session with no activity for thirty minutes is ended. Continued use keeps extending it.",
      "tags": [
        "auth",
        "sessions"
      ]
    },
    {
      "id": "password-policy",
      "category": "constraint",
      "title": "Password policy is length only, twelve characters",
      "content": "A password must be at least twelve characters. Composition rules were dropped because they produced predictable patterns that brute force tools guess first.",
      "tags": [
        "auth",
        "security"
      ]
    },
    {
      "id": "api-versioning",
      "category": "decision",
      "title": "API version travels in the URL path",
      "content": "The major version sits in the URL path. A breaking change means a new version, never a change to an existing one.",
      "tags": [
        "api",
        "versioning"
      ]
    },
    {
      "id": "deprecation-window",
      "category": "constraint",
      "title": "Deprecated endpoints live six more months",
      "content": "A deprecated endpoint keeps working six months after announcement, carrying a Sunset header naming the date.",
      "tags": [
        "api",
        "deprecation"
      ]
    },
    {
      "id": "billing-proration",
      "category": "decision",
      "title": "Plan changes are prorated to the day",
      "content": "Upgrading mid-cycle bills the difference for the remaining days. A downgrade takes effect at renewal instead.",
      "tags": [
        "billing",
        "plans"
      ]
    },
    {
      "id": "invoices-pdf",
      "category": "architecture",
      "title": "Invoices are rendered once and stored",
      "content": "An invoice PDF is generated when the charge settles and stored immutably. Re-rendering on demand is never done.",
      "tags": [
        "billing",
        "invoices"
      ]
    }
  ],
